---
import { CONTACT } from '../config';
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-ink-2 pt-20 md:pt-28">
  <div class="gutter grid gap-12 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <address class="max-w-sm text-body not-italic text-white">
      <p>{CONTACT.address}</p>
      <p class="mt-4">
        <a href={`tel:${CONTACT.phone.replace(/[^\d+]/g, '')}`} class="hover:text-primary-hover">{CONTACT.phone}</a>
      </p>
      <p>
        <a href={`mailto:${CONTACT.email}`} class="hover:text-primary-hover">{CONTACT.email}</a>
      </p>
    </address>

    <nav aria-label="Legal">
      <h2 class="text-small font-semibold text-polo-blue">Legal</h2>
      <ul class="mt-3 space-y-2">
        <li><a href="/privacy_policy" class="hover:text-primary-hover">Privacy Policy</a></li>
        <li><a href="/terms-and-conditions" class="hover:text-primary-hover">Terms and Conditions</a></li>
      </ul>
    </nav>

    <nav aria-label="Company">
      <h2 class="text-small font-semibold text-polo-blue">Company</h2>
      <ul class="mt-3 space-y-2">
        <li><a href="/about-us" class="hover:text-primary-hover">About</a></li>
        <li><a href="/contacts" class="hover:text-primary-hover">Contact</a></li>
      </ul>
    </nav>

    <nav aria-label="Social">
      <h2 class="text-small font-semibold text-polo-blue">Follow us</h2>
      <ul class="mt-3 space-y-2">
        <li><a href={CONTACT.facebook} rel="noopener" class="hover:text-primary-hover">Facebook</a></li>
        <li><a href={CONTACT.linkedin} rel="noopener" class="hover:text-primary-hover">LinkedIn</a></li>
      </ul>
    </nav>
  </div>

  <!-- The name returns at full width: a closing mark, not decoration to read. -->
  <p
    aria-hidden="true"
    class="mt-16 select-none whitespace-nowrap text-center font-bold leading-[0.8] tracking-[-0.05em] text-ink-3"
    style="font-size: 15.5vw"
  >
    Bina Cloud
  </p>

  <p class="gutter relative -mt-[2vw] bg-ink-2 pb-8 pt-6 text-small text-white/80">
    &copy; {year} All rights reserved. Made by Bina CloudTech
  </p>
</footer>
