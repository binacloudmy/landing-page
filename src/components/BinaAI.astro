---
import { DEMO_URL } from '../config';

// Copy is limited to what bina-ai's code and docs support; the claim-to-file map is in the build report.
const exchange = [
  { who: 'You', text: 'Tag semua pintu kat Aras 2.' },
  { who: 'Bina AI', text: 'Found the doors on Level 2 and the tag family to use. Ready to tag them in this view. Confirm?' },
  { who: 'You', text: 'Confirm.' },
  { who: 'Bina AI', text: 'Tagged the doors on Level 2 and read the model back to check every one has its tag. Two doors have no Mark; listed below.' },
];

const also = [
  {
    title: 'JKR compliance',
    text: 'Ask what JKR requires, in English or Bahasa Malaysia. Answers come from the ingested JKR specification, and codified rules run as checks, not guesses, with suggested fixes.',
  },
  {
    title: 'MS Project',
    text: 'Read a programme file and ask it questions: what blocks handover, what is Ali working on, when does foundation work start.',
  },
  {
    title: 'Maintenance and cost',
    text: 'A maintenance-management assistant and cost services (insights, matching and review) run on the same platform.',
  },
];
---

<!-- CLAIMS PENDING SIGN-OFF: see report -->
<section id="ai" class="py-[var(--section-gap)]">
  <div class="gutter">
    <p class="text-small font-semibold text-bina-blue">Bina AI</p>
    <h2 class="mt-3 max-w-[14ch] text-display font-semibold">A copilot for drafters.</h2>
  </div>

  <div class="gutter mt-16 grid gap-12 lg:grid-cols-[5fr_7fr] lg:gap-20">
    <div>
      <p class="text-lead text-white/80">
        A chat pane inside Revit. Type what you want, in English or Bahasa Malaysia. The copilot plans the
        steps, runs them against your live model, and reports back with real element counts.
      </p>
      <ul class="mt-10 space-y-6">
        <li>
          <h3 class="text-lead font-semibold">Asks before it changes anything</h3>
          <p class="mt-1 text-white/75">Every change to the model waits for your confirmation, then the copilot reads the model back to check it happened.</p>
        </li>
        <li>
          <h3 class="text-lead font-semibold">From CAD to model</h3>
          <p class="mt-1 text-white/75">Walls, beams, columns and lighting generated from the layers of a linked DWG.</p>
        </li>
        <li>
          <h3 class="text-lead font-semibold">Schedules, naming and QA</h3>
          <p class="mt-1 text-white/75">Door and window schedules in JKR format, naming audits, bulk parameter edits, and pre-submission sweeps for duplicate walls and model warnings.</p>
        </li>
        <li>
          <h3 class="text-lead font-semibold">Sheets and tags</h3>
          <p class="mt-1 text-white/75">Place views on sheets, dimension grids and tag everything in a view.</p>
        </li>
      </ul>
    </div>

    <div class="self-start bg-ink-2 p-6 sm:p-8 lg:p-10" role="figure" aria-label="Example conversation with Bina AI in Revit">
      <p class="text-small text-polo-blue">In Revit, illustrative example</p>
      <ol class="mt-6 space-y-5">
        {
          exchange.map((m) => (
            <li class={m.who === 'You' ? 'ml-auto max-w-[85%] bg-ink-3 p-4' : 'max-w-[92%] p-4 text-white/90'}>
              <p class="text-small font-semibold text-bina-blue">{m.who}</p>
              <p class="mt-1">{m.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-8 text-small text-polo-blue">Actions: find doors on Level 2, confirm, tag in view, verify.</p>
    </div>
  </div>

  <div class="gutter mt-24 grid gap-px sm:grid-cols-3">
    {
      also.map((a) => (
        <div class="bg-ink-2 p-6 sm:p-8">
          <h3 class="text-lead font-semibold">{a.title}</h3>
          <p class="mt-3 text-white/75">{a.text}</p>
        </div>
      ))
    }
  </div>

  <div class="gutter mt-12">
    <a href={DEMO_URL} class="btn btn-primary">Talk to us about Bina AI</a>
  </div>
</section>
